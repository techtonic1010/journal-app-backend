# ========================================
# JOURNAL APP - ENVIRONMENT VARIABLES
# ========================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to Git!

# ========================================
# EMAIL CONFIGURATION (Gmail SMTP)
# ========================================
GMAIL_USERNAME=your_email@gmail.com
GMAIL_PASSWORD=your_google_app_password

# ========================================
# REDIS CONFIGURATION
# ========================================
REDIS_HOST=your-redis-host.redns.redis-cloud.com
REDIS_PORT=10473
REDIS_PASSWORD=your_redis_password

# ========================================
# KAFKA CONFIGURATION
# ========================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_USERNAME=your_kafka_username
KAFKA_PASSWORD=your_kafka_password

# ========================================
# JWT SECRET KEY
# ========================================
# Use a strong random string (min 32 characters)
# Generate one: openssl rand -base64 32
JWT_SECRET_KEY=your_jwt_secret_key_min_32_characters_long

# ========================================
# WEATHER API
# ========================================
# Get from: https://weatherstack.com/
WEATHER_API_KEY=your_weather_api_key

# ========================================
# MONGODB (Optional - for Atlas)
# ========================================
MONGO_URI=mongodb://localhost:27017/test
